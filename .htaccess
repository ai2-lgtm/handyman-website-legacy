<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
# Handyman.ae - Pre-rendered Static Site
Options -Indexes
DirectoryIndex index.html

# ============================================================
# REWRITES
# ============================================================
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www to non-www
RewriteCond %{HTTP_HOST} ^www\.handyman\.ae [NC]
RewriteRule ^(.*)$ https://handyman.ae/$1 [L,R=301]

# Add trailing slash for directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Serve index.html for clean directory URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# ============================================================
# CACHING - Normal caching for HTML, long cache for assets
# ============================================================
<IfModule mod_headers.c>
    # HTML pages - short cache
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    
    # Static assets - long cache
    <FilesMatch "\.(js|css|woff2|woff|ttf|otf|png|jpg|jpeg|webp|svg|ico|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ============================================================
# COMPRESSION
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# MIME types
AddType application/javascript .js
AddType text/css .css
AddType image/webp .webp
AddType image/svg+xml .svg

# Custom 404
ErrorDocument 404 /404/index.html

# === Manus V5 thin-page redirects ===
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^clinic-maintenance-dubai/?$ /handyman-dubai/ [R=301,L]
RewriteRule ^retail-maintenance-dubai/?$ /handyman-dubai/ [R=301,L]
RewriteRule ^property-investor-maintenance-dubai/?$ /handyman-dubai/ [R=301,L]
</IfModule>
# === end Manus V5 thin-page redirects ===
